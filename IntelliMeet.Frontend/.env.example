# Copy to `.env.local`. Restart `npm run dev` after changes.
#
# Clerk Dashboard → API Keys → Publishable key (starts with pk_test_ or pk_live_).
# Never add the Clerk secret key here — it belongs only on the server.

VITE_CLERK_PUBLISHABLE_KEY=

# Optional: only if you run the backend with HTTPS (dotnet run --launch-profile https)
# VITE_API_PROXY_TARGET=https://localhost:7032
